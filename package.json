{
  "name": "rpg-md",
  "version": "0.1.0",
  "description": "Parse RPG-MD — Markdown syntax for inline fields, formulas and dice — to HAST.",
  "keywords": [
    "markdown",
    "ttrpg",
    "rpg",
    "character-sheet",
    "hast",
    "unified",
    "rehype",
    "remark",
    "micromark",
    "dice"
  ],
  "license": "MIT",
  "homepage": "https://fictionboard.github.io/rpg-md/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fictionboard/rpg-md.git"
  },
  "bugs": {
    "url": "https://github.com/fictionboard/rpg-md/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/pack-exports.mjs",
    "postpack": "node scripts/pack-exports.mjs --restore",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-types": "^2.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
